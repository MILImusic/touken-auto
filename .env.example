# 游戏账号
UID=your_uid_here
SERVER=your_server_here

# 从 Chrome DevTools → Application → Cookies 复制 sword 值
# 用于跳过登录直接测试 API
SWORD=your_sword_cookie_here

# Telegram 通知（可选）
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# HTTP 代理（可选，留空则不使用代理）
# HTTP_PROXY=http://127.0.0.1:7897

# 远征配置（部队号:地图ID，逗号分隔）
# 默认：2队→2-4, 3队→4-2, 4队→5-1, 5队→5-2
# EXPEDITION_TARGETS=2:8,3:14,4:17,5:18

# 限时锻造活动 ID（从抓包 forge/startmultiple 请求获取，每次活动不同）
# MILEAGE_EVENT_ID=10498
